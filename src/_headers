/*
  X-Placeholder: csp-disabled
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML pages and routes stay at stable URLs and revalidate after each deployment.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/about
  Cache-Control: public, max-age=0, must-revalidate
/menu
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate
/checkout
  Cache-Control: public, max-age=0, must-revalidate
/customize
  Cache-Control: public, max-age=0, must-revalidate
/return
  Cache-Control: public, max-age=0, must-revalidate
/authenticate
  Cache-Control: public, max-age=0, must-revalidate
/error
  Cache-Control: public, max-age=0, must-revalidate
/mail
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted stylesheets can be cached because each content change gets a new URL.
/styles/*
  Cache-Control: public, max-age=31536000, immutable

# Local imagery and codec WASM files are revalidated daily.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
