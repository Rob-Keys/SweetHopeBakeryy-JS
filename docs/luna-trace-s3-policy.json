{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckTraceBucketPrivacy",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicyStatus",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::cf-templates-1id935irfrtba-us-east-1"
    },
    {
      "Sid": "WriteLunaRunTracesOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::cf-templates-1id935irfrtba-us-east-1/luna-traces/*"
    }
  ]
}
